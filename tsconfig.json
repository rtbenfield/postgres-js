{
  "extends": "@tsconfig/strictest",
  "compilerOptions": {
    "lib": ["ES2024"],
    "module": "ES2022",
    "target": "ES2024",
    // output options
    "outDir": "dist/",
    "rootDir": "src/",
    "declaration": true,
    "sourceMap": true,
    // safety checks (extended from @tsconfig/strictest)
    "erasableSyntaxOnly": true,
    "noUnusedParameters": false,
    "noUnusedLocals": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
